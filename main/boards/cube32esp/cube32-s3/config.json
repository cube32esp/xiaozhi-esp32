{
    "target": "esp32s3",
    "builds": [
        {
            "name": "cube32-s3",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_CUBE32_S3=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/cube32/16m.csv\"",
                "CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y",
                "CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y",

                "CONFIG_CUBE32_BOARD_S3_CORE=y",
                "CONFIG_CUBE32_DISPLAY_ENABLED=y",
                "CONFIG_CUBE32_LVGL_ENABLED=y",
                "CONFIG_CUBE32_TOUCH_ENABLED=y",
                "CONFIG_CUBE32_LVGL_TASK_PRIORITY=1",
                "CONFIG_CUBE32_LVGL_BUFFER_LINES=10",
                "CONFIG_CUBE32_LVGL_DOUBLE_BUFFER=n",
                "CONFIG_CUBE32_LVGL_USE_SPIRAM=n",
                "CONFIG_CUBE32_AUDIO_ENABLED=y",
                "CONFIG_CUBE32_CAMERA_ENABLED=y",
                "CONFIG_CUBE32_ADC_BUTTON_ENABLED=y",
                "CONFIG_CUBE32_PMU_ENABLED=y",
                "CONFIG_CUBE32_RTC_ENABLED=y",
                "CONFIG_CUBE32_BLE_OTA_ENABLED=y",
                "CONFIG_CUBE32_BLE_OTA_MTU_SIZE=512",
                "CONFIG_CUBE32_MODEM_ENABLED=y",
                "CONFIG_CUBE32_MODEM_CONNECTION_RUNTIME=y",
                "CONFIG_CUBE32_ROBOT_HEAD_ENABLED=n",
                "CONFIG_CUBE32_FACE_EXPRESSION_ENABLED=y",
                "CONFIG_CUBE32_SERVO_ENABLED=n",
                "CONFIG_CUBE32_IMU_ENABLED=y",
                "CONFIG_CUBE32_MAG_ENABLED=y",
                "CONFIG_CUBE32_USB_INPUT_ENABLED=n",
                "CONFIG_CUBE32_SDCARD_ENABLED=n",
                "CONFIG_CUBE32_AUDIO_INPUT_SAMPLE_RATE=16000",
                "CONFIG_CUBE32_AUDIO_OUTPUT_SAMPLE_RATE=16000",
                "CONFIG_CUBE32_BLE_OTA_DOUBLE_BOOT_ENABLE=n",

                "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512",

                "CONFIG_CAMERA_NO_AFFINITY=y",
                "CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192",
                "CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n",

                "CONFIG_ESP_MODEM_ADD_FLOW_CONTROL=y",
                "CONFIG_ESP_MODEM_CMUX_DEFRAGMENT_PAYLOAD=y",
                "CONFIG_ESP_MODEM_PPP_SERVER_SUPPORT=y",
                "CONFIG_PPP_SUPPORT=y",
                "CONFIG_PPP_PAP_SUPPORT=y",
                "CONFIG_PPP_CHAP_SUPPORT=y",
                "CONFIG_PPP_MSCHAP_SUPPORT=y",
                "CONFIG_PPP_MPPE_SUPPORT=y",

                "CONFIG_USB_OTG_SUPPORTED=y",
                "CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024",
                "CONFIG_USB_HOST_HW_BUFFER_BIAS_BALANCED=y",

                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_NIMBLE_ENABLED=y",
                "CONFIG_BT_BLUEDROID_ENABLED=n",
                "CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y",
                "CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y",
                "CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1",
                "CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y",
                "CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y",
                "CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192",
                "CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512",
                "CONFIG_BT_NIMBLE_TRANSPORT_ACL_SIZE=512",
                "CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24",
                "CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=32",
                "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n",

                "CONFIG_LV_FONT_MONTSERRAT_10=y",
                "CONFIG_LV_FONT_MONTSERRAT_20=y",
                "CONFIG_LV_FONT_MONTSERRAT_24=y"
            ]
        }
    ]
}
